# Local development
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002

# For a staging build, replace both values with the public HTTPS API origin.
# If nginx proxies the API and Socket.IO on the staging domain:
# NEXT_PUBLIC_BACKEND_URL=https://staging.zentrictechnology.com
# NEXT_PUBLIC_SOCKET_URL=https://staging.zentrictechnology.com
